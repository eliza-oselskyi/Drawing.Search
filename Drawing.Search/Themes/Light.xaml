<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IBM Carbon-inspired Light Theme / White -->

    <!-- Core colors -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryBackgroundColor">#F4F4F4</Color>
    <Color x:Key="ForegroundColor">#161616</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="HighlightColor">#D0E2FF</Color>
    <Color x:Key="GhostTextColor">#A8A8A8</Color>
    <Color x:Key="DisabledForegroundColor">#80161616</Color>
    <Color x:Key="DisabledBorderColor">#80C6C6C6</Color>
    <Color x:Key="DisabledCheckmarkColor">#8D8D8D</Color>

    <!-- Carbon palette brushes -->
    <SolidColorBrush x:Key="BackgroundGlobal" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundHover" Color="#E8E8E8" />
    <SolidColorBrush x:Key="BackgroundInverse" Color="#393939" />
    <SolidColorBrush x:Key="BackgroundInverseHover" Color="#4C4C4C" />
    <SolidColorBrush x:Key="BackgroundAccent" Color="#0F62FE" />

    <SolidColorBrush x:Key="Layer01" Color="#F4F4F4" />
    <SolidColorBrush x:Key="Layer02" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Layer03" Color="#F4F4F4" />

    <SolidColorBrush x:Key="LayerHover01" Color="#E8E8E8" />
    <SolidColorBrush x:Key="LayerHover02" Color="#E8E8E8" />
    <SolidColorBrush x:Key="LayerHover03" Color="#E8E8E8" />

    <SolidColorBrush x:Key="LayerActive01" Color="#C6C6C6" />
    <SolidColorBrush x:Key="LayerActive02" Color="#C6C6C6" />
    <SolidColorBrush x:Key="LayerActive03" Color="#C6C6C6" />

    <SolidColorBrush x:Key="LayerSelected01" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LayerSelected02" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LayerSelected03" Color="#E0E0E0" />

    <SolidColorBrush x:Key="LayerSelectedHover01" Color="#D1D1D1" />
    <SolidColorBrush x:Key="LayerSelectedHover02" Color="#D1D1D1" />
    <SolidColorBrush x:Key="LayerSelectedHover03" Color="#D1D1D1" />
    <SolidColorBrush x:Key="LayerSelectedInverse" Color="#161616" />
    <SolidColorBrush x:Key="LayerSelectedDisabled" Color="#F4F4F4" />

    <SolidColorBrush x:Key="LayerAccent01" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LayerAccent02" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LayerAccent03" Color="#E0E0E0" />

    <SolidColorBrush x:Key="LayerAccentHover01" Color="#D1D1D1" />
    <SolidColorBrush x:Key="LayerAccentHover02" Color="#D1D1D1" />
    <SolidColorBrush x:Key="LayerAccentHover03" Color="#D1D1D1" />

    <SolidColorBrush x:Key="LayerAccentActive01" Color="#A8A8A8" />
    <SolidColorBrush x:Key="LayerAccentActive02" Color="#A8A8A8" />
    <SolidColorBrush x:Key="LayerAccentActive03" Color="#A8A8A8" />

    <SolidColorBrush x:Key="Field01" Color="#F4F4F4" />
    <SolidColorBrush x:Key="Field02" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Field03" Color="#F4F4F4" />

    <SolidColorBrush x:Key="FieldHover01" Color="#E8E8E8" />
    <SolidColorBrush x:Key="FieldHover02" Color="#E8E8E8" />
    <SolidColorBrush x:Key="FieldHover03" Color="#E8E8E8" />

    <SolidColorBrush x:Key="BorderInteractive" Color="#0F62FE" />
    <SolidColorBrush x:Key="BorderSubtle00" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BorderSubtle01" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BorderSubtle02" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BorderSubtle03" Color="#E0E0E0" />

    <SolidColorBrush x:Key="BorderSubtleSelected01" Color="#C6C6C6" />
    <SolidColorBrush x:Key="BorderSubtleSelected02" Color="#C6C6C6" />
    <SolidColorBrush x:Key="BorderSubtleSelected03" Color="#C6C6C6" />

    <SolidColorBrush x:Key="BorderStrong01" Color="#8D8D8D" />
    <SolidColorBrush x:Key="BorderStrong02" Color="#8D8D8D" />
    <SolidColorBrush x:Key="BorderStrong03" Color="#8D8D8D" />

    <SolidColorBrush x:Key="BorderTile01" Color="#C6C6C6" />
    <SolidColorBrush x:Key="BorderTile02" Color="#A8A8A8" />
    <SolidColorBrush x:Key="BorderTile03" Color="#8D8D8D" />

    <SolidColorBrush x:Key="BorderInverse" Color="#161616" />
    <SolidColorBrush x:Key="BorderDisabled" Color="#80C6C6C6" />

    <SolidColorBrush x:Key="TextPrimary" Color="#161616" />
    <SolidColorBrush x:Key="TextSecondary" Color="#525252" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#A8A8A8" />
    <SolidColorBrush x:Key="TextOnColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnColorDisabled" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="TextError" Color="#DA1E28" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#80161616" />

    <SolidColorBrush x:Key="SupportError" Color="#DA1E28" />
    <SolidColorBrush x:Key="SupportErrorInverse" Color="#FA4D56" />
    <SolidColorBrush x:Key="SupportSuccess" Color="#24A148" />
    <SolidColorBrush x:Key="SupportSuccessInverse" Color="#42BE65" />
    <SolidColorBrush x:Key="SupportWarning" Color="#F1C21B" />
    <SolidColorBrush x:Key="SupportWarningInverse" Color="#F1C21B" />
    <SolidColorBrush x:Key="SupportInfo" Color="#0043CE" />
    <SolidColorBrush x:Key="SupportInfoInverse" Color="#4589FF" />

    <SolidColorBrush x:Key="Interactive" Color="#0F62FE" />
    <SolidColorBrush x:Key="Highlight" Color="#D0E2FF" />

    <SolidColorBrush x:Key="ButtonPrimary" Color="#0F62FE" />
    <SolidColorBrush x:Key="ButtonPrimaryHover" Color="#0353E9" />
    <SolidColorBrush x:Key="ButtonPrimaryActive" Color="#002D9C" />
    <SolidColorBrush x:Key="ButtonSecondary" Color="#393939" />
    <SolidColorBrush x:Key="ButtonSecondaryHover" Color="#4C4C4C" />
    <SolidColorBrush x:Key="ButtonSecondaryActive" Color="#6F6F6F" />
    <SolidColorBrush x:Key="ButtonTertiary" Color="#0F62FE" />
    <SolidColorBrush x:Key="ButtonTertiaryHover" Color="#0353E9" />
    <SolidColorBrush x:Key="ButtonTertiaryActive" Color="#002D9C" />
    <SolidColorBrush x:Key="ButtonDisabled" Color="#80C6C6C6" />

    <!-- Compatibility brushes used by existing views/styles -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />
    <SolidColorBrush x:Key="DisabledCheckmarkBrush" Color="{StaticResource DisabledCheckmarkColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="GhostTextBrush" Color="{StaticResource GhostTextColor}" />

    <!-- Legacy aliases used by MainWindow/App styles -->
    <SolidColorBrush x:Key="DarkPanel" Color="#F4F4F4" />
    <SolidColorBrush x:Key="DarkPanelAlt" Color="#E0E0E0" />
    <SolidColorBrush x:Key="DarkBorder" Color="#C6C6C6" />
    <SolidColorBrush x:Key="AccentBlue" Color="#0F62FE" />
    <SolidColorBrush x:Key="AccentBlueHover" Color="#0353E9" />
    <SolidColorBrush x:Key="ProgressBackground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ProgressForeground" Color="#0F62FE" />

    <!-- Control Styles -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Layer01}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong01}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong01}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderDisabled}" />
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource Layer01}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle01}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
</ResourceDictionary>