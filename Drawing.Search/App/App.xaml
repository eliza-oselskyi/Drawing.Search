<Application x:Class="Drawing.Search.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!--
        ~1~ Light Theme @1@
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#000000" />
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#e6ecf5" />
        <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#666666" />

        ~1~ Dark Theme @1@
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="DarkForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkSecondaryBackgroundBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#404040" />
        <SolidColorBrush x:Key="DarkDisabledForegroundBrush" Color="#999999" />
        -->

        <!-- Default styles -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Drawing.Search;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Drawing.Search;component/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Drawing.Search;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            </Style>

            <!-- Color Palette -->
            <SolidColorBrush x:Key="DarkBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DarkPanel" Color="#252526" />
            <SolidColorBrush x:Key="DarkPanelAlt" Color="#2D2D30" />
            <SolidColorBrush x:Key="DarkBorder" Color="#3E3E42" />
            <SolidColorBrush x:Key="AccentBlue" Color="#1C97EA" />
            <SolidColorBrush x:Key="AccentBlueHover" Color="#3DAEF5" />
            <SolidColorBrush x:Key="AccentOrange" Color="#FF9F3A" />
            <SolidColorBrush x:Key="ErrorRed" Color="#F48771" />
            <SolidColorBrush x:Key="ErrorRedDark" Color="#5A1D1D" />
            <SolidColorBrush x:Key="SuccessGreen" Color="#8FD186" />
            <SolidColorBrush x:Key="SuccessGreenDark" Color="#1E3A1E" />
            <SolidColorBrush x:Key="TextPrimary" Color="#D4D4D4" />
            <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0" />
            <SolidColorBrush x:Key="TextDisabled" Color="#6E6E6E" />
            <SolidColorBrush x:Key="ProgressBackground" Color="#3E3E42" />
            <SolidColorBrush x:Key="ProgressForeground" Color="#1C97EA" />

            <!-- Typography Styles -->
            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Light" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SubheaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Semilight" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="MonospaceText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            </Style>

            <!--  Button -->
            <Style x:Key="CadButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DarkPanelAlt}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background"
                                            Value="{StaticResource DarkBorder}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#3E3E42" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2D2D30" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Action Button -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CadButton}">
                <Setter Property="Background" Value="{StaticResource AccentBlue}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background"
                                            Value="{StaticResource AccentBlueHover}" />
                                    <Setter TargetName="Border" Property="BorderBrush"
                                            Value="{StaticResource AccentBlueHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#005A9E" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                                    <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3E3E42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Panel -->
            <Style x:Key="CadPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DarkPanel}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- ProgressBar -->
            <Style x:Key="CadProgressBar" TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource ProgressBackground}" />
                <Setter Property="Foreground" Value="{StaticResource ProgressForeground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator"
                                            Background="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Left" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollBar Styles for Dark Theme -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DarkBorder}" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
            </Style>

        </ResourceDictionary>


    </Application.Resources>
</Application>